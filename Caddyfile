# Caddyfile

dev.echolet.xyz {
    # 1. Global Security (Basic Auth)
    # This now protects BOTH the React App and the API
    basicauth {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }

    # 2. API Routing
    # Routes requests from dev.echolet.xyz/api/* -> backend container
    # "handle_path" STRIPS the "/api" prefix, so backend gets "/users" instead of "/api/users"
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # 3. Frontend Routing
    # Routes everything else -> frontend container
    handle {
        reverse_proxy frontend:80
    }
}