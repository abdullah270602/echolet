# ===========================================
# Echolet Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# ===========================================

# -----------------
# Caddy Basic Auth
# -----------------
# Generate hash with: docker run --rm caddy:alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=$2a$14$REPLACE_WITH_ACTUAL_HASH

# -----------------
# Database
# -----------------
DATABASE_URL=postgresql+asyncpg://postgres:password@your-host:5432/echolet


# -----------------
# LiveKit
# -----------------
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# -----------------
# AI Services
# -----------------
DEEPGRAM_API_KEY=your_deepgram_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
INWORLD_API_KEY=your_inworld_api_key

# -----------------
# AWS SQS
# -----------------
SQS_QUEUE_URL=your_sqs_queue_url
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-north-1

# -----------------
# Clerk Authentication
# -----------------
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# -----------------
# Frontend (Build-time)
# -----------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_API_BASE_URL=https://api.echolet.com

# -----------------
# Usage Limits
# -----------------
DAILY_TALK_LIMIT_SECONDS=600

# -----------------
# Backend
# -----------------
# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://dev.echolet.xyz
# Public landing-page demo (anonymous calls with the starter agent)
DEMO_ENABLED=true
DEMO_MAX_SECONDS=120
DEMO_SESSIONS_PER_IP_PER_HOUR=3
DEMO_SESSIONS_PER_IP_PER_DAY=6
DEMO_MAX_CONCURRENT_CALLS=5
DEMO_SESSIONS_PER_DAY=200

# Clerk webhook signing secret (Clerk Dashboard -> Webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_secret
